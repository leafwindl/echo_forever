# LLM
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
TEMPERATURE=0.8
MAX_TOKENS=500
TIMEOUT=30
PROMPT_VERSION=echo-v1.0.0
ASSISTANT_PERSONA_VERSION=echo-persona-v1
# 无额外 tokenizer 依赖的保守估算预算；上线前应结合实际模型采样复核。
PERSONA_PROMPT_MAX_TOKENS=400
MEMORY_PROMPT_MAX_TOKENS=800
SUMMARY_PROMPT_MAX_TOKENS=800

# WeChat mini program
WECHAT_APPID=
WECHAT_SECRET=

# Auth
# Use a long random value in deployed environments.
AUTH_TOKEN_SECRET=change-this-to-a-long-random-secret
AUTH_TOKEN_EXPIRES_SECONDS=2592000
# Public test builds must use Bearer tokens.

# Deployment and storage
PUBLIC_BASE_URL=http://127.0.0.1:8000
APP_VERSION=1.0.0
BUILD_REVISION=unknown
ENABLE_API_DOCS=false

# Database
# Local direct-run example. Docker Compose overrides host to echo-postgres.
DATABASE_URL=postgresql://echo:echo_dev_password@127.0.0.1:5432/echo
DB_POOL_SIZE=5
DB_POOL_TIMEOUT_SECONDS=30

# Chat safety
ENABLE_CHAT_REQUEST_SERIALIZATION=true
CHAT_MESSAGE_MAX_CHARS=2000
CHAT_RATE_LIMIT_REQUESTS=10
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
CHAT_DAILY_REQUEST_LIMIT=100
GLOBAL_DAILY_CHAT_REQUEST_LIMIT=1000
LOGIN_RATE_LIMIT_REQUESTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_DAILY_REQUEST_LIMIT=100
GLOBAL_DAILY_LOGIN_REQUEST_LIMIT=1000
CONVERSATION_SUMMARY_TRIGGER_MESSAGES=24
CONVERSATION_SUMMARY_KEEP_RECENT_MESSAGES=12

# Tencent ASR
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_APP_ID=0

# TTS. CosyVoice v3.5 Flash requires a custom cloned or designed voice.
TTS_PROVIDER=cosyvoice
TTS_VOICE_ID=
TTS_SPEED=1.0
TTS_SEGMENT_MAX_CHARS=80
TTS_REPLY_MAX_CHARS=600
TTS_AUDIO_MAX_BYTES=10485760
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
COSYVOICE_MODEL=cosyvoice-v3.5-flash
# Optional override. By default the Beijing workspace endpoint is derived from Workspace ID.
COSYVOICE_WEBSOCKET_URL=
COSYVOICE_INSTRUCTION=用温柔、自然、亲近的语气说话，语速稍慢，像在陪伴用户聊天。
COSYVOICE_VOLUME=50
COSYVOICE_PITCH_RATE=1.0
COSYVOICE_TIMEOUT_SECONDS=30

# Tencent streaming ASR
VOICE_STREAMING_ASR_ENABLED=false
TENCENT_ASR_ENGINE_MODEL_TYPE=16k_zh
TENCENT_ASR_FINAL_TIMEOUT_SECONDS=10

# Voice file cleanup
VOICE_UPLOAD_MAX_BYTES=10485760
VOICE_RATE_LIMIT_REQUESTS=5
VOICE_RATE_LIMIT_WINDOW_SECONDS=60
VOICE_DAILY_REQUEST_LIMIT=30
GLOBAL_DAILY_VOICE_REQUEST_LIMIT=300
VOICE_GENERATED_RETENTION_SECONDS=86400
VOICE_UPLOAD_RETENTION_SECONDS=300
VOICE_CLEANUP_INTERVAL_SECONDS=3600
VOICE_CLEANUP_BATCH_SIZE=500

# Embedding
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_VECTOR_DIMENSION=1024
MEMORY_VECTOR_TOP_K=5
MEMORY_VECTOR_SCORE_THRESHOLD=0.25
