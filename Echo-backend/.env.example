# LLM
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
TEMPERATURE=0.8
MAX_TOKENS=500
TIMEOUT=30

# WeChat mini program
WECHAT_APPID=
WECHAT_SECRET=

# Auth
# Use a long random value in deployed environments.
AUTH_TOKEN_SECRET=change-this-to-a-long-random-secret
AUTH_TOKEN_EXPIRES_SECONDS=2592000
# Set false after the mini program has been updated to send Bearer tokens.
ENABLE_LEGACY_USER_ID_AUTH=true

# Deployment and storage
PUBLIC_BASE_URL=http://127.0.0.1:8000
# Docker Compose overrides this to /app/data/echo_memory.db.
# ECHO_DB_PATH=/app/data/echo_memory.db

# Chat safety
ENABLE_CHAT_REQUEST_SERIALIZATION=true

# Tencent ASR
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_APP_ID=0

# MiniMax TTS
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_TTS_VOICE_ID=zh-CN-XiaoxiaoNeural

# Voice file cleanup
VOICE_GENERATED_RETENTION_SECONDS=86400
VOICE_UPLOAD_RETENTION_SECONDS=300
VOICE_CLEANUP_INTERVAL_SECONDS=3600
VOICE_CLEANUP_BATCH_SIZE=500

# Internal debug API. Keep disabled for public testing/production.
ENABLE_ADMIN_DEBUG_API=false
ADMIN_DEBUG_TOKEN=change-me

# Embedding
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
MEMORY_VECTOR_TOP_K=5
MEMORY_VECTOR_SCORE_THRESHOLD=0.25
