# LLM
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
TEMPERATURE=0.8
MAX_TOKENS=500
CHAT_MAX_TOKENS=1800
CALL_MAX_TOKENS=256
CALL_HISTORY_MESSAGES=8
CALL_REPLY_MAX_CHARS=80
CALL_TOOL_ROUTING_ENABLED=false
CALL_WEB_SEARCH_ENABLED=false
CALL_SCHEDULE_TOOLS_ENABLED=false
CALL_PROGRESS_SPEECH_ENABLED=true
PROACTIVE_PLANNER_TEMPERATURE=0.1
PROACTIVE_PLANNER_MAX_TOKENS=320
PROACTIVE_PLANNER_FORMAT_RETRIES=1
TIMEOUT=30
PROMPT_VERSION=echo-v1.1.0
ASSISTANT_PERSONA_VERSION=echo-persona-v3
# 无额外 tokenizer 依赖的保守估算预算；上线前应结合实际模型采样复核。
PERSONA_PROMPT_MAX_TOKENS=400
MEMORY_PROMPT_MAX_TOKENS=800
SUMMARY_PROMPT_MAX_TOKENS=800

# Auth
# Use independent long random values in deployed environments.
AUTH_TOKEN_SECRET=change-this-to-a-long-random-secret
AUTH_ACCESS_TOKEN_EXPIRES_SECONDS=900
AUTH_REFRESH_TOKEN_PEPPER=change-this-to-an-independent-random-pepper
AUTH_REFRESH_TOKEN_EXPIRES_SECONDS=2592000
AUTH_JWT_ISSUER=echo-backend
AUTH_JWT_AUDIENCE=echo-app
AUTH_JWT_KEY_ID=echo-v1
AUTH_JWT_PREVIOUS_KEYS_JSON={}

# SMS. Keep code logging disabled outside an explicitly configured local environment.
SMS_PROVIDER=log
SMS_CODE_PEPPER=change-this-to-an-independent-random-pepper
SMS_CHALLENGE_EXPIRES_SECONDS=300
SMS_RESEND_AFTER_SECONDS=60
SMS_MAXIMUM_ATTEMPTS=5
SMS_LOG_VERIFICATION_CODE=false
SMS_FIXED_VERIFICATION_CODE=
SMS_STUB_DELIVERY_ENABLED=false
AUTH_INTERNAL_FIXTURE_PHONES=

# Aliyun/Tencent adapters are configuration stubs until vendor delivery is enabled.
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=

# Deployment and storage
PUBLIC_BASE_URL=http://127.0.0.1:8000
APP_VERSION=1.1.9
BUILD_REVISION=unknown
ENABLE_API_DOCS=false

# Windows desktop node
DESKTOP_PAIRING_CODE_TTL_SECONDS=600
DESKTOP_COMMAND_TIMEOUT_SECONDS=45
DESKTOP_VISION_ENABLED=true
DESKTOP_VISION_MODEL=deepseek-v4-flash-vision-exp
DESKTOP_VISION_MAX_TOKENS=500
DESKTOP_CAPTURE_MAX_BYTES=3000000

# Presence heartbeat (internal thoughts)
PRESENCE_ENABLED=true
PRESENCE_TICK_INTERVAL_SECONDS=900
PRESENCE_ACTIVE_WINDOW_MINUTES=5
PRESENCE_SILENCE_MINUTES=30
PRESENCE_MIN_THOUGHT_INTERVAL_MINUTES=45
PRESENCE_DAILY_THOUGHT_BUDGET=8
PRESENCE_CONTEXT_MESSAGES=8
PRESENCE_MAX_CANDIDATE_USERS=20
PRESENCE_THOUGHT_MAX_TOKENS=300
PRESENCE_THOUGHT_TEMPERATURE=0.9
PRESENCE_PROACTIVE_MESSAGE_BUDGET=3
PRESENCE_PROACTIVE_MESSAGE_INTERVAL_MINUTES=120
PRESENCE_MESSAGE_MAX_TOKENS=180
PRESENCE_MESSAGE_TEMPERATURE=0.8

# Tencent Cloud COS. Keep disabled until credentials are configured and the smoke test passes.
# The bucket remains private; the backend returns short-lived signed HTTPS URLs.
COS_ENABLED=false
COS_BUCKET=echo-1438300232
COS_REGION=ap-guangzhou
COS_SECRET_ID=
COS_SECRET_KEY=
# Temporary migration option: reuse TENCENT_SECRET_ID/TENCENT_SECRET_KEY used by ASR.
COS_REUSE_TENCENT_CREDENTIALS=false
# Leave empty until img.echoaiforever.cn has a valid HTTPS certificate.
COS_CUSTOM_DOMAIN=
COS_PRIVATE_READ=true
COS_OBJECT_PREFIX=echo
COS_SIGNED_URL_EXPIRES_SECONDS=900
COS_TIMEOUT_SECONDS=30

# Direct Android releases. Signed URLs are minted only after the user accepts an update.
RELEASE_DOWNLOAD_URL_EXPIRES_SECONDS=14400
RELEASE_RATE_LIMIT_REQUESTS=60
RELEASE_RATE_LIMIT_WINDOW_SECONDS=60

# Database
# Local direct-run example. Docker Compose overrides host to echo-postgres.
DATABASE_URL=postgresql://echo:echo_dev_password@127.0.0.1:5432/echo
DB_POOL_SIZE=5
DB_POOL_TIMEOUT_SECONDS=30

# Chat safety
ENABLE_CHAT_REQUEST_SERIALIZATION=true
CHAT_MESSAGE_MAX_CHARS=2000
CHAT_RATE_LIMIT_REQUESTS=10
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
CHAT_DAILY_REQUEST_LIMIT=100
GLOBAL_DAILY_CHAT_REQUEST_LIMIT=1000
CHAT_FOLLOWUP_TEXT_DELAY_MS=1200
CHAT_FINAL_TEXT_DELAY_MS=2000
CHAT_STICKER_DELAY_MS=1000
CHAT_MAX_TOTAL_DELAY_MS=15000
LOGIN_RATE_LIMIT_REQUESTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_DAILY_REQUEST_LIMIT=100
GLOBAL_DAILY_LOGIN_REQUEST_LIMIT=1000
CONVERSATION_SUMMARY_TRIGGER_MESSAGES=24
CONVERSATION_SUMMARY_KEEP_RECENT_MESSAGES=12
CONVERSATION_SUMMARY_TEMPERATURE=0.1
CONVERSATION_SUMMARY_MAX_TOKENS=1200
MEMORY_EXTRACTION_MAX_TOKENS=800

# Tencent ASR
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_APP_ID=0

# Personal Echo hardware device. Keep the device token private. The map keys are
# lower-case "Device-Id|Client-Id" pairs reported by the ESP32 firmware.
# A temporary "Device-Id|*" key supports the first full-image flash.
ECHO_DEVICE_TOKEN=
ECHO_DEVICE_USER_MAP_JSON={}
ECHO_DEVICE_MAX_UTTERANCE_SECONDS=30
ECHO_DEVICE_MAX_OPUS_PACKET_BYTES=4096
# Start with 500 ms for responsive Chinese turns. Raise toward 650-800 ms if
# physical testing shows sentence-final words are being clipped.
ECHO_DEVICE_AUTO_SILENCE_MS=650
ECHO_DEVICE_AUTO_MINIMUM_SPEECH_MS=360
ECHO_DEVICE_AUTO_SPEECH_RMS_THRESHOLD=700
ECHO_DEVICE_AUTO_NO_SPEECH_TIMEOUT_MS=8000
ECHO_DEVICE_AUTO_MAXIMUM_SPEECH_MS=30000
ECHO_DEVICE_PLAYBACK_START_DELAY_MS=120
ECHO_DEVICE_PLAYBACK_PREBUFFER_PACKETS=10
ECHO_DEVICE_PLAYBACK_STOP_GRACE_MS=240
ECHO_DEVICE_STREAMING_ENABLED=false
ECHO_DEVICE_REALTIME_ASR_ENABLED=false
ECHO_DEVICE_TTS_CHUNK_MAX_CHARS=18
ECHO_DEVICE_TTS_CHUNK_MIN_CHARS=8
ECHO_DEVICE_TTS_PREFETCH_PHRASES=2
ECHO_DEVICE_TTS_MAX_SILENCE_MS=240
ECHO_DEVICE_TTS_SILENCE_RMS_THRESHOLD=300
ECHO_DEVICE_STREAMING_PREBUFFER_PACKETS=4
ECHO_DEVICE_AUDIO_QUEUE_MAX_PACKETS=40
ECHO_FIRMWARE_VERSION=0.1.0

# TTS. CosyVoice v3.5 Flash requires a custom cloned or designed voice.
TTS_PROVIDER=cosyvoice
TTS_VOICE_ID=
TTS_SPEED=1.05
TTS_REPLY_MAX_CHARS=600
TTS_AUDIO_MAX_BYTES=10485760
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
COSYVOICE_MODEL=cosyvoice-v3.5-flash
COSYVOICE_MAX_CONCURRENT_STREAMS=2
# Optional override. By default the Beijing workspace endpoint is derived from Workspace ID.
COSYVOICE_WEBSOCKET_URL=
COSYVOICE_INSTRUCTION=用温柔、自然、亲近的语气连贯说话，语速稍快，句间只做极短停顿，不要长时间停顿，像在陪伴用户聊天。
COSYVOICE_VOLUME=50
COSYVOICE_PITCH_RATE=1.0
COSYVOICE_TIMEOUT_SECONDS=30

# Tencent streaming ASR
VOICE_STREAMING_ASR_ENABLED=false
TENCENT_ASR_ENGINE_MODEL_TYPE=16k_zh
TENCENT_ASR_FINAL_TIMEOUT_SECONDS=10

# Voice file cleanup
VOICE_UPLOAD_MAX_BYTES=10485760
VOICE_RATE_LIMIT_REQUESTS=5
VOICE_RATE_LIMIT_WINDOW_SECONDS=60
VOICE_DAILY_REQUEST_LIMIT=30
GLOBAL_DAILY_VOICE_REQUEST_LIMIT=300
VOICE_GENERATED_RETENTION_SECONDS=3600
VOICE_UPLOAD_RETENTION_SECONDS=300
VOICE_CLEANUP_INTERVAL_SECONDS=600
VOICE_CLEANUP_BATCH_SIZE=500

# Embedding
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_VECTOR_DIMENSION=1024
MEMORY_VECTOR_TOP_K=5
MEMORY_VECTOR_SCORE_THRESHOLD=0.25
# Agent and trusted time tools
AGENT_ENABLED=true
AGENT_MAX_STEPS=6
AGENT_MAX_TOOL_CALLS=4
AGENT_RUN_TIMEOUT_SECONDS=45
DEFAULT_USER_TIMEZONE=Asia/Shanghai

# Proactive chat scheduling
PROACTIVE_CHAT_ENABLED=true
PROACTIVE_CHAT_WORKER_INTERVAL_SECONDS=30
PROACTIVE_CHAT_JOB_LEASE_SECONDS=180

# Getui RestAPI V2. Keep MasterSecret on the backend and outside Git.
PUSH_ENABLED=false
GETUI_APP_ID=
GETUI_APP_KEY=
GETUI_MASTER_SECRET=
GETUI_HARMONY_APP_ID=u5JfZJNhsF65eKmzD17ok8
GETUI_HARMONY_APP_KEY=
GETUI_HARMONY_MASTER_SECRET=
GETUI_API_BASE_URL=https://restapi.getui.com/v2
PUSH_WORKER_INTERVAL_SECONDS=15

# Optional live web search (Tavily-compatible endpoint)
WEB_SEARCH_ENABLED=false
WEB_SEARCH_API_KEY=
WEB_SEARCH_BASE_URL=https://api.tavily.com/search
WEB_SEARCH_TIMEOUT_SECONDS=12
WEB_SEARCH_MAX_RESULTS=5

# Daily letters
DAILY_LETTER_ENABLED=true
DAILY_LETTER_GENERATION_TIME=07:45
DAILY_LETTER_PUBLISH_TIME=08:00
DAILY_LETTER_WORKER_INTERVAL_SECONDS=60
DAILY_LETTER_WORKER_BATCH_SIZE=20
DAILY_LETTER_GENERATION_VERSION=letter-agent-v2
DAILY_LETTER_MAX_ATTEMPTS=3
DAILY_LETTER_RETRY_OFFSETS_SECONDS=300,720
DAILY_LETTER_AGENT_TIMEOUT_SECONDS=120
DAILY_LETTER_AGENT_MAX_STEPS=2
DAILY_LETTER_MAX_TOKENS=2500
DAILY_LETTER_TARGET_MIN_CHARS=600
DAILY_LETTER_TARGET_MAX_CHARS=1000
DAILY_LETTER_CONTEXT_VERSION=daily-letter-context-v2
# Storage can be configured now, but letter image generation stays disabled.
LETTER_IMAGE_GENERATION_ENABLED=false
MINIMAX_IMAGE_API_KEY=
MINIMAX_IMAGE_BASE_URL=https://api.minimaxi.com/v1/image_generation
MINIMAX_IMAGE_MODEL=image-01
MINIMAX_IMAGE_TIMEOUT_SECONDS=120
LETTER_IMAGE_ASPECT_RATIO=4:3
LETTER_IMAGE_MAX_ATTEMPTS=2
LETTER_IMAGE_MAX_BYTES=10485760
LETTER_IMAGE_REFERENCE_ASSET=

# Sticker library and optional OpenAI-compatible image generation
STICKER_ENABLED=true
STICKER_UPLOAD_MAX_BYTES=5242880
STICKER_VECTOR_SEARCH_ENABLED=true
STICKER_VECTOR_TOP_K=12
STICKER_VECTOR_SCORE_THRESHOLD=0.55
STICKER_VECTOR_MAX_SCORE_GAP=0.04
STICKER_EMBEDDING_BACKFILL_LIMIT=500
STICKER_GENERATION_ENABLED=false
IMAGE_GENERATION_API_KEY=
IMAGE_GENERATION_BASE_URL=
