<view class="page">
  <view
    class="character-area {{chatExpanded ? 'character-area-expanded' : ''}}"
    style="flex: {{chatExpanded ? 3 : 7}};"
  >
    <character chat-expanded="{{chatExpanded}}" sit-crop="{{sitCrop}}" />
    <view class="letter-entry" bindtap="onOpenLetters" aria-label="Echo 来信">
      <text class="letter-icon">✉</text>
      <view class="letter-badge" wx:if="{{unreadLetterCount}}">{{unreadLetterCount}}</view>
    </view>
  </view>

  <view class="chat-container" style="flex: {{chatExpanded ? 7 : 3}};">
    <view class="chat-handle" bindtap="onToggleChatExpand">
      <text>{{chatExpanded ? '▼ 收起聊天' : '▲ 展开聊天'}}</text>
    </view>

    <view class="login-status" wx:if="{{isBootstrapping || errorText}}">
      <text>{{isBootstrapping ? '正在安全登录...' : errorText}}</text>
      <button
        wx:if="{{!isBootstrapping}}"
        class="login-retry-btn"
        size="mini"
        bindtap="onRetry"
      >重新登录</button>
    </view>

    <scroll-view
      class="chat-list"
      scroll-y
      scroll-into-view="{{lastMsgId}}"
      scroll-with-animation
      wx:else
    >
      <view class="message-padding">
        <block wx:for="{{messages}}" wx:key="id">
          <view class="msg-item {{item.sender}}" id="msg-{{item.id}}">
            <view class="bubble">
              <view wx:if="{{item.isTyping}}" class="typing-indicator">
                <view class="typing-dot"></view>
                <view class="typing-dot"></view>
                <view class="typing-dot"></view>
              </view>
              <block wx:else>
                <text selectable>{{item.content}}</text>
                <image wx:if="{{item.stickerUrl}}" class="sticker-image" src="{{item.stickerUrl}}" mode="aspectFit" />
                <view wx:if="{{item.sources && item.sources.length}}" class="source-list">
                  <view wx:for="{{item.sources}}" wx:for-item="source" wx:key="url" class="source-item" data-url="{{source.url}}" catchtap="onOpenSource">来源：{{source.title}}</view>
                </view>
              </block>
            </view>
          </view>
        </block>
        <view class="list-bottom"></view>
      </view>
    </scroll-view>

    <view class="input-area">
      <input
        class="input"
        value="{{inputText}}"
        disabled="{{!isReady || isSending}}"
        maxlength="2000"
        placeholder="{{isReady ? '说点什么...' : '请先完成登录'}}"
        bindinput="onInput"
        bindconfirm="onSend"
        confirm-type="send"
      />
      <button
        class="send-btn"
        disabled="{{!isReady || isSending || !inputText}}"
        bindtap="onSend"
      >{{isSending ? '等待' : '发送'}}</button>
      <button
        class="phone-mode-btn"
        disabled="{{!isReady || isSending}}"
        bindtap="onOpenCall"
        aria-label="进入电话模式"
      >
        <text>电话</text>
      </button>
    </view>

    <view class="chat-actions">
      <view class="action-btn" bindtap="onClearContext">清除上下文</view>
      <view class="action-btn primary" bindtap="onOpenPersonaPage">个性化设置</view>
      <view class="action-btn primary" bindtap="onOpenMemoryPage">记忆管理</view>
      <view class="action-btn primary" bindtap="onOpenLetters">Echo 来信</view>
    </view>
  </view>
</view>
