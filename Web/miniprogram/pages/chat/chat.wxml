<view class="page">
  <view class="character-band">
    <view class="topbar">
      <view class="echo-identity">
        <text class="echo-name">Echo</text>
        <view class="presence">
          <view class="presence-dot"></view>
          <text>在这里</text>
        </view>
      </view>

      <view class="top-actions">
        <button
          class="call-button"
          disabled="{{!isReady || isSending}}"
          bindtap="onOpenCall"
          hover-class="button-pressed"
        >
          <image class="button-icon" src="/assets/icons/phone.svg" mode="aspectFit" />
          <text>通话</text>
        </button>
        <button
          class="more-button"
          disabled="{{!isReady}}"
          bindtap="onOpenTools"
          hover-class="button-pressed"
          aria-label="更多设置"
        >
          <image class="button-icon" src="/assets/icons/ellipsis.svg" mode="aspectFit" />
        </button>
      </view>
    </view>

    <image class="character-image" src="/assets/images/echo_idle.png" mode="widthFix" />
    <view class="character-caption">
      <image class="caption-icon" src="/assets/icons/message-circle.svg" mode="aspectFit" />
      <text wx:if="{{displayName}}">{{displayName}}，我在这里</text>
      <text wx:else>我在这里</text>
    </view>
  </view>

  <view class="conversation-band">
    <view class="login-state" wx:if="{{isBootstrapping || errorText}}">
      <view class="loading-mark" wx:if="{{isBootstrapping}}"></view>
      <text>{{isBootstrapping ? '正在连接 Echo' : errorText}}</text>
      <button wx:if="{{!isBootstrapping}}" class="retry-button" bindtap="onRetry">重试</button>
    </view>

    <scroll-view
      class="message-list"
      scroll-y
      scroll-into-view="{{lastMsgId}}"
      scroll-with-animation
      wx:else
    >
      <view class="message-padding">
        <block wx:for="{{messages}}" wx:key="id">
          <view class="message-row {{item.sender}}" id="msg-{{item.id}}">
            <image
              wx:if="{{item.sender === 'echo'}}"
              class="message-avatar"
              src="/assets/images/echo_avatar.png"
              mode="aspectFill"
            />
            <view class="bubble">
              <view wx:if="{{item.isTyping}}" class="typing-indicator">
                <view class="typing-dot"></view>
                <view class="typing-dot"></view>
                <view class="typing-dot"></view>
              </view>
              <text wx:else selectable>{{item.content}}</text>
            </view>
          </view>
        </block>
        <view class="message-list-end"></view>
      </view>
    </scroll-view>

    <view class="composer">
      <button
        class="composer-tool"
        disabled="{{!isReady}}"
        bindtap="onOpenTools"
        hover-class="button-pressed"
        aria-label="聊天设置"
      >
        <image class="composer-icon" src="/assets/icons/plus.svg" mode="aspectFit" />
      </button>
      <input
        class="composer-input"
        value="{{inputText}}"
        disabled="{{!isReady || isSending}}"
        maxlength="2000"
        placeholder="发消息给 Echo"
        bindinput="onInput"
        bindconfirm="onSend"
        confirm-type="send"
      />
      <button
        class="send-button {{inputText ? 'active' : ''}}"
        disabled="{{!isReady || isSending || !inputText}}"
        bindtap="onSend"
        hover-class="button-pressed"
        aria-label="发送"
      >
        <image class="composer-icon send-icon" src="/assets/icons/arrow-up.svg" mode="aspectFit" />
      </button>
    </view>
  </view>
</view>
