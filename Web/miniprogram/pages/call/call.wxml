<view class="page">
  <image class="ambient-character" src="/assets/images/echo_idle.png" mode="widthFix" />
  <view class="veil"></view>

  <view class="call-content">
    <view class="call-heading">
      <text class="echo-name">Echo</text>
      <text class="call-time">{{elapsedLabel}}</text>
    </view>

    <view class="call-stage">
      <view class="avatar-frame {{status === 'speaking' ? 'speaking' : ''}}">
        <image class="avatar" src="/assets/images/echo_idle.png" mode="widthFix" />
      </view>

      <view class="status-block">
        <view class="wave {{status}}">
          <view class="bar"></view>
          <view class="bar"></view>
          <view class="bar"></view>
          <view class="bar"></view>
          <view class="bar"></view>
        </view>
        <text class="status-label">{{statusLabel}}</text>
        <text class="partial-text" wx:if="{{partialText}}">{{partialText}}</text>
      </view>

      <scroll-view class="caption" scroll-y wx:if="{{echoCaption}}">
        <text>{{echoCaption}}</text>
      </scroll-view>
    </view>

    <view class="call-actions">
      <view class="action-item">
        <view
          class="call-button talk-button {{isRecording ? 'recording' : ''}} {{!isReady || isSending ? 'disabled' : ''}}"
          aria-role="button"
          aria-label="{{isRecording ? '松开并发送语音' : '按住说话'}}"
          bindtouchstart="onStartRecord"
          bindtouchend="onStopRecord"
          bindtouchcancel="onCancelRecord"
        >
          <text class="button-main-label">{{isRecording ? '松开' : '按住'}}</text>
          <text class="button-sub-label">{{isRecording ? '发送' : '说话'}}</text>
        </view>
      </view>

      <view class="action-item">
        <view class="call-button hangup-button" aria-role="button" aria-label="结束通话" bindtap="onHangup">
          <text class="button-main-label">结束</text>
          <text class="button-sub-label">通话</text>
        </view>
      </view>
    </view>
  </view>
</view>
