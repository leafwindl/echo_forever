<view class="page">
  <view class="status-card" wx:if="{{isLoading}}">正在加载设置...</view>
  <view class="status-card error" wx:elif="{{errorText}}">
    <text>{{errorText}}</text>
    <button class="retry-btn" size="mini" bindtap="loadPersona">重试</button>
  </view>

  <scroll-view class="form" scroll-y wx:else>
    <view class="intro-card">
      <view class="intro-avatar">
        <image src="/assets/images/echo_idle.webp" mode="widthFix" />
      </view>
      <view class="intro-main">
        <text class="intro-title">你的交流偏好</text>
        <text class="intro-text">Echo 会在合适的语境里使用这些设置</text>
      </view>
      <switch color="#E96F8A" checked="{{enabled}}" bindchange="onEnabledChange" />
    </view>

    <view class="group-header">
      <text>称呼</text>
    </view>
    <view class="section">
      <text class="section-title">希望 Echo 怎么称呼你</text>
      <input class="text-input" maxlength="40" value="{{preferredName}}" placeholder="选填，例如：小叶" bindinput="onPreferredNameInput" />
    </view>

    <view class="group-header">
      <text>交流方式</text>
    </view>
    <view class="section">
      <text class="section-title">表达风格</text>
      <view class="choice-grid">
        <block wx:for="{{replyStyleOptions}}" wx:key="value">
          <view class="choice {{replyStyle === item.value ? 'selected' : ''}}" data-field="replyStyle" data-value="{{item.value}}" bindtap="onSelectChoice">
            <view class="choice-check" wx:if="{{replyStyle === item.value}}"><text>✓</text></view>
            <text class="choice-label">{{item.label}}</text>
            <text class="choice-description">{{item.description}}</text>
          </view>
        </block>
      </view>
    </view>

    <view class="section">
      <text class="section-title">回复长度</text>
      <view class="choice-grid">
        <block wx:for="{{replyLengthOptions}}" wx:key="value">
          <view class="choice {{replyLength === item.value ? 'selected' : ''}}" data-field="replyLength" data-value="{{item.value}}" bindtap="onSelectChoice">
            <view class="choice-check" wx:if="{{replyLength === item.value}}"><text>✓</text></view>
            <text class="choice-label">{{item.label}}</text>
            <text class="choice-description">{{item.description}}</text>
          </view>
        </block>
      </view>
    </view>

    <view class="section">
      <text class="section-title">遇到烦恼时</text>
      <view class="choice-grid">
        <block wx:for="{{supportModeOptions}}" wx:key="value">
          <view class="choice {{supportMode === item.value ? 'selected' : ''}}" data-field="supportMode" data-value="{{item.value}}" bindtap="onSelectChoice">
            <view class="choice-check" wx:if="{{supportMode === item.value}}"><text>✓</text></view>
            <text class="choice-label">{{item.label}}</text>
            <text class="choice-description">{{item.description}}</text>
          </view>
        </block>
      </view>
    </view>

    <view class="section">
      <text class="section-title">主动程度</text>
      <view class="choice-grid">
        <block wx:for="{{proactivityOptions}}" wx:key="value">
          <view class="choice {{proactivity === item.value ? 'selected' : ''}}" data-field="proactivity" data-value="{{item.value}}" bindtap="onSelectChoice">
            <view class="choice-check" wx:if="{{proactivity === item.value}}"><text>✓</text></view>
            <text class="choice-label">{{item.label}}</text>
            <text class="choice-description">{{item.description}}</text>
          </view>
        </block>
      </view>
    </view>

    <view class="group-header">
      <text>关系节奏</text>
    </view>
    <view class="section">
      <text class="section-title">关系发展节奏</text>
      <view class="choice-grid">
        <block wx:for="{{relationshipPaceOptions}}" wx:key="value">
          <view class="choice {{relationshipPace === item.value ? 'selected' : ''}}" data-field="relationshipPace" data-value="{{item.value}}" bindtap="onSelectChoice">
            <view class="choice-check" wx:if="{{relationshipPace === item.value}}"><text>✓</text></view>
            <text class="choice-label">{{item.label}}</text>
            <text class="choice-description">{{item.description}}</text>
          </view>
        </block>
      </view>
    </view>

    <view class="section">
      <text class="section-title">亲近表达</text>
      <view class="choice-grid">
        <block wx:for="{{affectionStyleOptions}}" wx:key="value">
          <view class="choice {{affectionStyle === item.value ? 'selected' : ''}}" data-field="affectionStyle" data-value="{{item.value}}" bindtap="onSelectChoice">
            <view class="choice-check" wx:if="{{affectionStyle === item.value}}"><text>✓</text></view>
            <text class="choice-label">{{item.label}}</text>
            <text class="choice-description">{{item.description}}</text>
          </view>
        </block>
      </view>
    </view>

    <view class="group-header">
      <text>边界与背景</text>
    </view>
    <view class="section">
      <view class="section-heading">
        <text class="section-title">避免主动展开的话题</text>
        <text class="section-count">{{avoidTopics.length}}/5</text>
      </view>
      <view class="topics">
        <view wx:for="{{presetTopics}}" wx:key="label" class="topic {{item.selected ? 'selected' : ''}}" data-topic="{{item.label}}" bindtap="onToggleTopic">{{item.label}}</view>
        <view wx:for="{{customAvoidTopics}}" wx:key="*this" class="topic selected" data-topic="{{item}}" bindtap="onToggleTopic">{{item}} ×</view>
      </view>
      <view class="topic-input-row">
        <input class="topic-input" maxlength="40" value="{{customTopic}}" placeholder="添加其他话题" bindinput="onCustomTopicInput" bindconfirm="onAddCustomTopic" confirm-type="done" />
        <button class="add-topic-btn" size="mini" bindtap="onAddCustomTopic">添加</button>
      </view>
      <text class="hint">Echo 不会主动展开这些话题；安全相关或你主动询问时仍会正常回应。</text>
    </view>

    <view class="section">
      <view class="section-heading">
        <text class="section-title">关于你</text>
        <text class="section-count">{{aboutUser.length}}/300</text>
      </view>
      <textarea class="about-input" maxlength="300" value="{{aboutUser}}" placeholder="选填，例如你的兴趣、当前目标或沟通习惯。这里的内容只作为背景信息。" bindinput="onAboutUserInput" />
    </view>

    <view class="privacy-note">恢复默认不会影响长期记忆和聊天记录。</view>
    <button class="relationship-reset-btn" disabled="{{isSaving}}" bindtap="onResetRelationship">重置关系进度</button>
    <view class="bottom-space"></view>
  </scroll-view>

  <view class="bottom-actions" wx:if="{{!isLoading}}">
    <button class="reset-btn" disabled="{{isSaving}}" bindtap="onReset">恢复默认</button>
    <button class="save-btn" loading="{{isSaving}}" disabled="{{isSaving || errorText}}" bindtap="onSave">保存设置</button>
  </view>
</view>
