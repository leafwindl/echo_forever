<view class="page">
  <view class="header">
    <view><view class="title">表情包库</view><view class="sub">你保存的图片只属于你的私人空间</view></view>
    <button class="add" bindtap="onChoose">添加</button>
  </view>
  <view wx:if="{{loading}}" class="empty">正在整理…</view>
  <view wx:elif="{{!items.length}}" class="empty">还没有表情包，先存一张喜欢的吧。</view>
  <view wx:else class="grid">
    <view wx:for="{{items}}" wx:key="sticker_id" class="card">
      <image src="{{item.url}}" mode="aspectFit" class="image" />
      <view class="description">{{item.description || '未命名表情'}}</view>
      <view wx:if="{{item.owner_type === 'user'}}" class="delete" data-id="{{item.sticker_id}}" bindtap="onDelete">删除</view>
    </view>
  </view>
</view>
