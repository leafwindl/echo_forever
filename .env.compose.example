# Docker Compose reads deployment values from a root-level .env file.
POSTGRES_DB=echo
POSTGRES_USER=echo
POSTGRES_PASSWORD=change-this-to-a-long-random-password
DATABASE_URL_DOCKER=postgresql://echo:change-this-to-a-long-random-password@echo-postgres:5432/echo

# PostgreSQL automatic backup
POSTGRES_BACKUP_INTERVAL_SECONDS=86400
POSTGRES_BACKUP_RETENTION_DAYS=7
